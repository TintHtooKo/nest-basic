<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Welcome to NBlog</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 20px;
      background: #f5f5f5;
      font-family: Arial, sans-serif;
    "
  >
    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table
            width="500"
            cellpadding="0"
            cellspacing="0"
            style="
              background: #ffffff;
              padding: 30px;
              border: 1px solid #dddddd;
            "
          >
            <tr>
              <td>
                <h2 style="margin: 0 0 20px; color: #222">
                  Welcome to NBlog! 🎉
                </h2>

                <p style="margin: 0 0 15px">Hi <strong><%= name %></strong>,</p>

                <p style="margin: 0 0 15px">
                  Thank you for creating your NBlog account. We're happy to have
                  you with us.
                </p>

                <p style="margin: 0 0 10px">
                  <strong>Name:</strong> <%= name %>
                </p>

                <p style="margin: 0 0 20px">
                  <strong>Email:</strong> <%= email %>
                </p>

                <p style="margin: 0 0 20px">
                  You can now sign in and start sharing your stories.
                </p>

                <hr style="border: none; border-top: 1px solid #dddddd" />

                <p style="font-size: 12px; color: #888888; margin: 20px 0 0">
                  © <%= new Date().getFullYear() %> NBlog. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>